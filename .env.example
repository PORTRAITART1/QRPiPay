# =============================================
# QRPiPay Environment Configuration
# =============================================

# Environment Mode
NODE_ENV=development

# Server Port
PORT=3001

# =============================================
# DATABASE CONFIGURATION
# =============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=qrpipay
DB_USER=qrpipay
DB_PASSWORD=dev_password_change_in_production

# Complete PostgreSQL URL (Render compatible)
DATABASE_URL=postgresql://qrpipay:dev_password_change_in_production@postgres:5432/qrpipay

# =============================================
# SECURITY & JWT
# =============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRE=7d

# =============================================
# FRONTEND URL (CORS)
# =============================================
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

# =============================================
# PI NETWORK CONFIGURATION
# =============================================
PI_API_KEY=your-pi-network-api-key
PI_API_URL=https://api.minepi.com
PI_APP_ID=your-pi-app-id

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info

# =============================================
# CORS ORIGIN
# =============================================
CORS_ORIGIN=http://localhost:3000
