# Production environment - Backend QRPiPay (EXAMPLE)
# Copy to .env.production and update with real values

# Server
PORT=3001
NODE_ENV=production

# Database (provided by Render PostgreSQL - auto-injected)
DATABASE_URL=postgresql://qrpipay:PASSWORD@HOST:5432/qrpipay

# Frontend URL
FRONTEND_URL=https://qrpipay.onrender.com

# JWT Secret (Generate a secure random value)
JWT_SECRET=your_secure_jwt_secret_here_64_chars_min

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=https://qrpipay.onrender.com
