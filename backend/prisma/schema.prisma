generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  piAddress String   @unique
  username  String?
  email     String?  @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments   Payment[]
  qrcodes    QRCode[]
  transactions Transaction[]
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  currency  String   @default("Pi")
  status    String   @default("pending")
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([status])
}

model QRCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  piAmount  Float
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([userId])
}

model BetaApplication {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  piAddress String
  experience String   @default("beginner")
  motivation String?
  agreeTerms Boolean  @default(false)
  status    String   @default("PENDING")
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feedback  String?

  @@index([status])
  @@index([email])
}
