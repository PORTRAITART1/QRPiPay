        "method": "GET",
        "path": "/api/auth/me"
      }
    },
    
    "payments": {
      "create": {
        "method": "POST",
        "path": "/api/payments/create"
      },
      "get_status": {
        "method": "GET",
        "path": "/api/payments/:paymentId"
      },
      "complete": {
        "method": "POST",
        "path": "/api/payments/:paymentId/complete"
      },
      "history": {
        "method": "GET",
        "path": "/api/payments/history/all"
      }
    }
