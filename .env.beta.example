# 🧪 Beta Program Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/qrpipay

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Admin Key (for beta admin dashboard)
ADMIN_KEY=your-secret-admin-key-change-this

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Node Environment
NODE_ENV=development

# Server Port
PORT=3001

# Render Deployment (if deploying to Render)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Pi Network Configuration
PI_API_KEY=your-pi-api-key
PI_API_URL=https://api.mainnet.pi/v2

# Sentry Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn

# Google Forms Feedback (optional)
GOOGLE_FORMS_ID=your-google-form-id
